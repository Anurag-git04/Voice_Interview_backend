# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Whisper Configuration (for speech-to-text)
WHISPER_MODEL=whisper-large-v3-turbo

# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/interview_coach?retryWrites=true&w=majority

# JWT Authentication Configuration
JWT_SECRET=your-secret-key-min-32-characters-long-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_DAYS=7

# CORS Configuration
FRONTEND_ORIGIN=http://localhost:3000
# Optional: Comma-separated list of additional allowed origins for production
# Example: ALLOWED_ORIGINS=https://app.vercel.app,https://app2.vercel.app
ALLOWED_ORIGINS=

# Rate Limiting
MAX_AUDIO_SECONDS=90
MAX_QUESTIONS_PER_SESSION=10
